# このファイルは変数名の一覧です。実値は絶対に入力しないでください（各自の .env.local / Cloud Run の環境変数で設定）。

# --- サーバー側のみ（Route Handlers から読む。ブラウザへ配布しない） ---
# Gemini API キー
GEMINI_API_KEY=
# Gemini のモデル名（未設定時はコード側の既定値 gemini-2.5-flash を使う）
GEMINI_MODEL=
# Firebase Admin SDK（Issue 2。membership 発行に使用）
# Cloud Run ではデフォルトのサービスアカウント（Application Default Credentials）を使うため通常は未設定でよい。
# ローカルで動かす場合のみ、サービスアカウント鍵のパスを設定する（鍵ファイル自体はリポジトリに置かない）。
GOOGLE_APPLICATION_CREDENTIALS=
# Admin SDK のプロジェクトIDを明示する場合のみ設定（通常は NEXT_PUBLIC_FIREBASE_PROJECT_ID / GOOGLE_CLOUD_PROJECT から解決する）
FIREBASE_ADMIN_PROJECT_ID=

# --- Firebase クライアント接続（NEXT_PUBLIC_ はブラウザへ配布される。権限は Firestore ルールで守る） ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
